                                           "format":  "table",
                                           "rawQuery":  true,
                                           "rawSql":  "select\n  \"OrderId\" as \"Order ID\",\n  \"Status\" as \"Status\",\n  round(extract(epoch from (now() at time zone 'utc' - \"UpdatedAt\"))) as \"Processing Age Seconds\",\n  \"IdempotencyKey\" as \"Idempotency Key\",\n  \"CreatedAt\" as \"Created At\",\n  \"UpdatedAt\" as \"Updated At\"\nfrom payment.\"PaymentTransactions\"\nwhere \"Status\" = 'Processing'\n  and \"UpdatedAt\" < (now() at time zone 'utc' - interval '60 seconds')\norder by \"UpdatedAt\" asc\nlimit 20;",
